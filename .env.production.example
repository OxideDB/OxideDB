# Required: at least 32 characters. Generate a unique value per deployment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Use a new key id when rotating JWT secrets.
OXIDEDB_JWT_KEY_ID=active

# JSON object of previous key ids to secrets accepted during a rotation window.
OXIDEDB_JWT_PREVIOUS_KEYS={}

# Keep true for internet-exposed deployments behind a TLS proxy that sends X-Forwarded-Proto: https.
OXIDEDB_REQUIRE_HTTPS=true
OXIDEDB_COOKIE_SECURE=true
OXIDEDB_COOKIE_SAME_SITE=Lax

# HTTP port exposed by compose on the host.
OXIDEDB_PORT=8080

# Default request body limit: 16 MiB.
OXIDEDB_MAX_REQUEST_SIZE=16777216

# Comma-separated origins if CORS is enabled in a custom command.
OXIDEDB_CORS_ALLOWED_ORIGINS=https://admin.example.com
